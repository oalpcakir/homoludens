{
  "name": "homoludens",
  "compatibility_date": "2025-09-01",
  // worker.js serves /api/* and the Borderlines share links (/borderlines/s/*); everything else comes straight from ./public
  "main": "worker.js",
  // keep variables and secrets set in the Cloudflare dashboard when deploying from Git
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/borderlines/s/*"]
  },
  // New-game email list. Create a KV namespace called "homoludens-subscribers" in the Cloudflare dashboard
  // (Storage & Databases → KV), then put its id here and remove the // in front of the three lines.
  // "kv_namespaces": [
  //   { "binding": "SUBSCRIBERS", "id": "PASTE_KV_NAMESPACE_ID" }
  // ],
  // at most 3 feedback messages / sign-ups per visitor per minute
  "ratelimits": [
    { "name": "FEEDBACK_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    // admin page: up to 30 requests per minute (it loads several stats tabs)
    { "name": "ADMIN_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ]
}
