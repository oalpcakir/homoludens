{
  "name": "homoludens",
  "compatibility_date": "2025-09-01",
  // worker.js serves /api/* and the share links (/borderlines/s/*, /kantar/s/*, /polder/s/*); everything else comes straight from ./public
  "main": "worker.js",
  // keep variables and secrets set in the Cloudflare dashboard when deploying from Git
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/borderlines/s/*", "/kantar/s/*", "/polder/s/*"]
  },
  // New-game email list. Create a KV namespace called "homoludens-subscribers" in the Cloudflare dashboard
  // (Storage & Databases → KV), then put its id here and remove the // in front of the three lines.
  // "kv_namespaces": [
  //   { "binding": "SUBSCRIBERS", "id": "PASTE_KV_NAMESPACE_ID" }
  // ],
  // Borderlines "You beat N% of today's players" (optional; without it the line is simply not shown).
  // Create a second KV namespace called "homoludens-stats" (Storage & Databases → KV), then add this line to the
  // kv_namespaces list above (remove the // in front of that list's lines too if SUBSCRIBERS isn't set up yet):
  //   { "binding": "STATS", "id": "PASTE_STATS_KV_NAMESPACE_ID" }
  // at most 3 feedback messages / sign-ups per visitor per minute
  "ratelimits": [
    { "name": "FEEDBACK_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }
  ]
}
